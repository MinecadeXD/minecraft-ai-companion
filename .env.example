# --- Social conversation ---
SOCIAL_MAX_RESPONDERS=2
SOCIAL_INITIATIVE_ENABLED=true
SOCIAL_MAX_TURNS=4

# 2. Official OpenAI Provider
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Google Gemini Provider
GEMINI_API_KEY=your_google_gemini_api_key

# --- Minecraft Server Connection ---
MC_HOST=nina.hidencloud.com
MC_PORT=24683
MC_USERNAME=Notch
MC_VERSION=1.20.4

# --- Bot Gameplay Settings ---
BOT_OWNER=Itz_Minecade
